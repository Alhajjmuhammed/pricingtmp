# Billing (Wellongepay) GraphQL backend -- pricing, catalog, subscriptions.
# Public, unauthenticated resolvers only (see lib/api-config.ts).
NEXT_PUBLIC_BILLING_GRAPHQL_URL=https://backwellongepay.eopsprimax.com/graphql/

# The tenant whose catalog/pricing this storefront shows.
NEXT_PUBLIC_BILLING_TENANT_ID=05cf2f3e-eef4-400e-9a4d-a4e74421fb0e

# Wellonge ID Backend — Central identity system (registration, profiles,
# organizations). All user accounts are mirrored here after registration.
# Both vars point at the same real backend; two names because
# wellongeIdService.ts and wellongeIdSyncService.ts were written separately.
NEXT_PUBLIC_REST_API_URL=https://backidall.eopsprimax.com
NEXT_PUBLIC_WELLONGE_ID_URL=https://backidall.eopsprimax.com

# NBC card verification / payment method save -- REST endpoints on the
# same billing backend host (kept as-is functionally, not part of the
# billing GraphQL API work; only the localhost placeholder was corrected)

# Destination product systems -- after a paid registration, the account is
# also provisioned into Client User Management (always) and whichever of
# these matches the chosen category (Tax Compliance / Buyer / Supplier).
# See services/provisioning/destinationSystems.ts.
NEXT_PUBLIC_CLIENT_MGMT_GRAPHQL_URL=https://backclientall.eopsprimax.com/graphql/
NEXT_PUBLIC_TAX_COMPLIANCE_GRAPHQL_URL=https://backtaxcomply.eopsprimax.com/graphql/
NEXT_PUBLIC_SUPPLIER_GRAPHQL_URL=https://backsupplier.eopsprimax.com/graphql/
